---
import {
	getRouteKey,
	PAGE_PLATE_NAMES,
	ROUTES_WITH_OWN_TITLE,
} from "@/constants/page-names";

const { path } = Astro.props;
const route = getRouteKey(path, import.meta.env.BASE_URL);
const plate = ROUTES_WITH_OWN_TITLE.has(route) ? undefined : PAGE_PLATE_NAMES[route];
---
{plate && <div class="p3-masthead page-plate" aria-hidden="true" data-p3-masthead>
  <div class="page-plate__row">
    <span class="page-plate__zh" data-p3-masthead-type>{plate.zh}</span>
    <span class="page-plate__en" lang="en">{plate.en}</span>
  </div>
</div>}
