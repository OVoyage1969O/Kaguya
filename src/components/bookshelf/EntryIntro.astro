---
import type { BookshelfEntryIntro } from "@/types/config";
import "@/styles/components/entry-intro.css";

interface Props {
	intro: BookshelfEntryIntro;
	/** 记录「已播放」用的稳定标识，默认取视频地址。 */
	storageKey?: string;
}

const { intro, storageKey = intro.video } = Astro.props;
const once = intro.once !== false;
---

<!-- 开场动画：初次打开词条时播放一次。
     preload="none" 保证已经看过的访客不会再下载这个文件；
     真正的播放与「只看一次」判断在 src/utils/entry-intro.ts 里。 -->
<div
	class="p3-intro"
	data-p3-intro
	data-src={intro.video}
	data-once={once ? "1" : "0"}
	data-key={storageKey}
	hidden
>
	<video
		class="p3-intro__video"
		muted
		playsinline
		preload="none"
		aria-hidden="true"
		tabindex="-1"
	></video>
</div>
