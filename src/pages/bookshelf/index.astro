---
import Icon from "@components/common/Icon.astro";
import { bookshelfConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getBookshelfCatalogue,
	VOLUME_NUMERALS,
} from "@/utils/bookshelf-data";
import "@/styles/pages/bookshelf-shelf.css";

const volumes = await getBookshelfCatalogue();
const entries = volumes.flatMap((volume) => volume.items);
const characters = entries.filter((entry) => entry.person && entry.image);
const volumeCount =
	volumes.length <= VOLUME_NUMERALS.length
		? VOLUME_NUMERALS[volumes.length - 1]
		: String(volumes.length);

const initialVolume = volumes[0];

const orbitalVolumesData = volumes.map((vol, index) => ({
	index,
	code: String(index + 1).padStart(2, "0"),
	id: vol.id,
	name: vol.name,
	english: vol.english,
	volumeNumeral: vol.volumeNumeral,
	volumeRoman: vol.volumeRoman,
	era: vol.era,
	locale: vol.locale,
	synopsis: vol.editorialSynopsis,
	cover: vol.coverResolved,
	href: vol.href,
	count: vol.items.length,
	entries: vol.items.map((item) => ({
		folio: item.folio,
		title: item.title,
		groupLabel: item.groupLabel,
		summary: item.summary,
		quote: item.quote,
		previewImage: item.previewImage,
		href: item.href,
	})),
}));
---

<MainGridLayout
	title={bookshelfConfig.name}
	description={bookshelfConfig.description}
	hasOwnH1={true}
>
	<div class="encyc" data-encyc-root>
		<!-- ================================================================
		     第一幕：开放式素白 WebGL2 三维晶体星轨圣殿
		     无笨重外框，三维多尖簇晶体直接悬浮于素白光学空间，径向外置编号零遮挡。
		     ================================================================ -->
		<section
			class="prism-orbit-stage"
			id="worlds"
			aria-label="永远百科三维晶体星轨导航"
			data-prism-orbital-root
			data-orbital-volumes={JSON.stringify(orbitalVolumesData)}
		>
			<!-- 左侧：WebGL2 三维晶体星轨画布 + 动态绯红共振波 + 外置编号 -->
			<div class="prism-orbit-left">
				<div class="prism-orbit-viewport" data-orbital-viewport>
					<canvas
						class="prism-orbit-canvas"
						data-prism-orbital-canvas
						aria-label="三维晶体星轨，可拖拽旋转或点击晶体切换世界分卷"
					></canvas>

					<!-- 绯红共振折线（置于画布上方、清晰连接红宝石核心与激活石英晶体） -->
					<svg
						class="prism-orbit-tether"
						data-orbital-svg
						aria-hidden="true"
					>
						<path
							class="prism-orbit-tether__glow"
							data-orbital-tether-glow
							d=""
						></path>
						<path
							class="prism-orbit-tether__line"
							data-orbital-tether
							d=""
						></path>
					</svg>

					<!-- 3D 径向外置投影编号（极简 01..05，永不遮挡晶体） -->
					<div class="prism-orbit-labels" data-orbital-labels>
						<span
							class="prism-orbit-center-tag"
							data-orbital-center-tag
							lang="en"
						>
							AUTO
						</span>
						{volumes.map((vol, idx) => (
							<button
								type="button"
								class:list={["prism-orbit-node", { "is-active": idx === 0 }]}
								data-orbital-node={idx}
								aria-pressed={idx === 0 ? "true" : "false"}
								title={`${vol.volumeNumeral} · ${vol.name}`}
							>
								<span class="prism-orbit-node__num" lang="en">
									{String(idx + 1).padStart(2, "0")}
								</span>
								{idx === 0 && (
									<span
										class="prism-orbit-node__badge"
										data-orbital-badge
										lang="en"
									>
										· ACTIVE
									</span>
								)}
							</button>
						))}
					</div>
				</div>

				<!-- 底部极简 5 卷快捷切换条（同步 3D 星轨，方便键盘与触屏一眼选择） -->
				<nav class="prism-orbit-strip" aria-label="世界分卷切换">
					{volumes.map((vol, idx) => (
						<button
							type="button"
							class:list={["prism-orbit-tab", { "is-active": idx === 0 }]}
							data-orbital-tab={idx}
							aria-pressed={idx === 0 ? "true" : "false"}
						>
							<span class="prism-orbit-tab__code" lang="en">
								{String(idx + 1).padStart(2, "0")}
							</span>
							<span class="prism-orbit-tab__name">{vol.name}</span>
						</button>
					))}
				</nav>
			</div>

			<!-- 右侧：参考图同款素白极简档案面板 -->
			<div class="prism-orbit-panel">
				<div class="prism-orbit-panel__head">
					<span class="prism-orbit-panel__archive" lang="en">
						<i class="prism-diamond" aria-hidden="true"></i>
						<span data-orbital-header>ARCHIVE // VOLUME 01</span>
					</span>
					<span class="prism-orbit-panel__status" lang="en">
						<i class="prism-diamond prism-diamond--sm" aria-hidden="true"></i>
						<span data-orbital-era>{initialVolume.era}</span>
					</span>
				</div>

				<div class="prism-orbit-panel__rule" aria-hidden="true">
					<span></span>
					<i></i>
				</div>

				<div class="prism-orbit-panel__identity">
					<div class="prism-orbit-panel__heading">
						<p class="prism-orbit-panel__brand">永远百科 · ETERNAL CODEX</p>
						<h1 class="prism-orbit-panel__title" data-orbital-title>
							{initialVolume.name}
						</h1>
						<p class="prism-orbit-panel__en" lang="en" data-orbital-en>
							{initialVolume.english}
						</p>
					</div>

					<a
						class="prism-orbit-panel__plate"
						href={initialVolume.href}
						data-orbital-plate-link
						aria-label={`打开${initialVolume.name}专刊`}
					>
						<img
							data-orbital-plate-img
							src={initialVolume.coverResolved}
							alt={`${initialVolume.name}卷首原画`}
							width="240"
							height="180"
							loading="eager"
							decoding="async"
						/>
						<span class="prism-orbit-panel__plate-tag" data-orbital-locale>
							{initialVolume.locale}
						</span>
					</a>
				</div>

				<p class="prism-orbit-panel__synopsis" data-orbital-synopsis>
					{initialVolume.editorialSynopsis}
				</p>

				<!-- 致敬参考图一 `◆ — TITLE` 细线词条目录（悬停可联动左侧标本画预览） -->
				<ul
					class="prism-menu-list"
					aria-label="当前分卷收录词条"
					data-orbital-menu
				>
					{initialVolume.items.map((item) => (
						<li>
							<a
								class="prism-menu-item"
								href={item.href}
								data-preview-img={item.previewImage}
								data-preview-note={
									item.quote ? `「${item.quote}」` : item.summary
								}
							>
								<span class="prism-menu-item__mark" aria-hidden="true">
									<i class="prism-diamond prism-diamond--sm"></i>
									<em class="prism-menu-item__stem"></em>
								</span>
								<span class="prism-menu-item__title">{item.title}</span>
								<span class="prism-menu-item__meta">{item.groupLabel}</span>
								<span class="prism-menu-item__folio" lang="en">
									NO.{item.folio}
								</span>
							</a>
						</li>
					))}
				</ul>

				<!-- 参考图一同款切面红宝石菱形主 CTA -->
				<div class="prism-orbit-panel__cta">
					<a
						class="prism-lozenge"
						href={initialVolume.href}
						data-orbital-enter
					>
						<span class="prism-lozenge__en" lang="en">OPEN ARCHIVE</span>
						<span class="prism-lozenge__zh" data-orbital-enter-label>
							步入「{initialVolume.name}」专刊
						</span>
					</a>
				</div>

				<div class="prism-orbit-panel__foot">
					<span class="prism-orbit-panel__meta-line" data-orbital-meta-line>
						ARCHIVE // {initialVolume.volumeNumeral} · {initialVolume.items.length} 篇收录 | 馆藏共 {volumeCount}卷 {entries.length} 词条
					</span>
					<div class="prism-orbit-panel__quick-links">
						<button type="button" data-orbital-random>
							◆ SHUFFLE // 随机读取记忆
						</button>
						<a href="#characters">◆ DOSSIERS // 人物档案</a>
						<a href="#catalogue">◆ INDEX // 总目检索 (/)</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ================================================================
		     第二幕：人物画廊（素白装裱 + 3D 微倾物理视差）
		     ================================================================ -->
		{characters.length > 0 && (
			<section
				class="encyc-section"
				id="characters"
				aria-labelledby="characters-title"
			>
				<header class="encyc-section__head" data-encyc-reveal>
					<div>
						<span class="encyc-section__eyebrow" lang="en">
							◆ PORTRAIT DOSSIERS // 人物画廊
						</span>
						<h2 id="characters-title">人物档案</h2>
					</div>
					<p>
						沿着一个名字，读懂一座屋邸与一个世界。悬停画框可唤出角色箴言与能力图谱标记。
					</p>
				</header>

				<ul class="encyc-people">
					{characters.map((entry, idx) => (
						<li data-encyc-reveal style={`--stagger:${idx}`}>
							<a
								class={`encyc-person encyc-person--${entry.categoryId}`}
								href={entry.href}
								data-encyc-tilt
							>
								<div class="encyc-person__mat" data-encyc-tilt-card>
									<div class="encyc-person__mat-head">
										<span class="encyc-person__plate" lang="en">
											PLATE {String(idx + 1).padStart(2, "0")}
										</span>
										{entry.hasStats && (
											<span class="encyc-person__badge">能力图谱</span>
										)}
									</div>
									<div class="encyc-person__frame">
										<img
											src={entry.image}
											alt={entry.title}
											width="500"
											height="660"
											loading="lazy"
											decoding="async"
											data-encyc-tilt-img
										/>
										{entry.quote && (
											<div class="encyc-person__quote">
												<p>「{entry.quote}」</p>
											</div>
										)}
									</div>
								</div>
								<div class="encyc-person__caption">
									<div class="encyc-person__title-row">
										<span class="encyc-person__name">{entry.title}</span>
										<span class="encyc-person__folio">NO. {entry.folio}</span>
									</div>
									<span class="encyc-person__world">
										<i class="encyc-world-dot" data-world={entry.categoryId}></i>
										{entry.categoryName} · {entry.groupLabel}
									</span>
									{entry.summary && (
										<span class="encyc-person__summary">{entry.summary}</span>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<!-- ================================================================
		     第三幕：完整馆藏总目（`/` 快捷键 + 游走红宝石底线 + 阻尼悬浮画片）
		     ================================================================ -->
		<section
			class="encyc-section encyc-catalogue"
			id="catalogue"
			aria-labelledby="catalogue-title"
		>
			<header class="encyc-section__head" data-encyc-reveal>
				<div>
					<span class="encyc-section__eyebrow" lang="en">
						◆ COMPLETE INDEX // 馆藏总目
					</span>
					<h2 id="catalogue-title">完整目录</h2>
				</div>
				<p>按名称、世界分卷、角色身份或台词关键词即时筛选全部馆藏词条。</p>
			</header>

			<div class="encyc-ledger-controls" data-encyc-reveal>
				<form class="encyc-search" role="search" data-encyc-search-form>
					<label class="sr-only" for="encyc-query">搜索百科词条</label>
					<Icon name="material-symbols:search-rounded" />
					<input
						id="encyc-query"
						type="search"
						name="q"
						placeholder="搜索词条、人物、设定或台词…"
						autocomplete="off"
						data-encyc-search
					/>
					<kbd class="encyc-search__kbd" data-encyc-kbd aria-hidden="true">
						/
					</kbd>
					<button
						type="button"
						data-encyc-clear
						aria-label="清空搜索"
						hidden
					>
						<Icon name="material-symbols:close-rounded" />
					</button>
				</form>

				<div class="encyc-filters-bar">
					<div
						class="encyc-filters"
						role="group"
						aria-label="按分卷筛选"
						data-encyc-filters
					>
						<span
							class="encyc-filters__glider"
							data-encyc-filter-glider
							aria-hidden="true"
						></span>
						<button
							type="button"
							class="is-active"
							aria-pressed="true"
							data-encyc-filter="all"
						>
							<span>全部</span>
							<sup>{entries.length}</sup>
						</button>
						{volumes.map((volume) => (
							<button
								type="button"
								aria-pressed="false"
								data-encyc-filter={volume.id}
							>
								<i class="encyc-world-dot" data-world={volume.id}></i>
								<span>{volume.name}</span>
								<sup>{volume.items.length}</sup>
							</button>
						))}
					</div>
					<p
						class="encyc-result"
						role="status"
						aria-live="polite"
						data-encyc-result
					>
						共 {entries.length} 篇词条
					</p>
				</div>
			</div>

			<div class="encyc-ledger-stage" data-encyc-ledger-stage>
				<ul class="encyc-index" data-encyc-results>
					{entries.map((entry) => (
						<li
							data-encyc-entry
							data-category={entry.categoryId}
							data-search={`${entry.title} ${entry.summary} ${entry.categoryName} ${entry.groupLabel} ${entry.quote}`}
							data-preview-src={entry.previewImage}
							data-preview-folio={`FOLIO ${entry.folio}`}
							data-preview-label={`${entry.categoryName} · ${entry.groupLabel}`}
						>
							<a href={entry.href}>
								<span class="encyc-index__folio">{entry.folio}</span>
								<span class="encyc-index__main">
									<span class="encyc-index__title">{entry.title}</span>
									<span class="encyc-index__tag">{entry.groupLabel}</span>
								</span>
								<span class="encyc-index__summary">
									{entry.summary || "打开词条，继续阅读。"}
								</span>
								<span class="encyc-index__volume">
									<i
										class="encyc-world-dot"
										data-world={entry.categoryId}
									></i>
									<span>{entry.categoryName}</span>
									<Icon name="material-symbols:arrow-outward-rounded" />
								</span>
							</a>
						</li>
					))}
				</ul>

				<div
					class="encyc-hover-card"
					data-encyc-hover-card
					aria-hidden="true"
					hidden
				>
					<div class="encyc-hover-card__frame">
						<img
							data-encyc-hover-img
							src=""
							alt=""
							width="240"
							height="300"
							decoding="async"
						/>
					</div>
					<div class="encyc-hover-card__meta">
						<span data-encyc-hover-folio lang="en">FOLIO 01</span>
						<small data-encyc-hover-label>型月世界</small>
					</div>
				</div>
			</div>

			<div class="encyc-empty" data-encyc-empty hidden>
				<p class="encyc-empty__title">未能在藏书室中寻获对应词条</p>
				<p>试试更简短的关键词，或切回全部世界分卷浏览。</p>
				<button class="encyc-btn encyc-btn--ghost" type="button" data-encyc-reset>
					<span>显示全部 {entries.length} 篇词条</span>
				</button>
			</div>

			<noscript>
				<p class="encyc-result">
					目录已完整列出。启用 JavaScript 后可体验 WebGL2 三维晶体星轨与检索筛选。
				</p>
			</noscript>
		</section>
	</div>

	<script>
		import { initEncyclopediaLifecycle } from "@/utils/encyclopedia-home";
		initEncyclopediaLifecycle();
	</script>
</MainGridLayout>
