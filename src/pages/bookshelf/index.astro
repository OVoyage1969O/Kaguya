---
import Icon from "@components/common/Icon.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import { bookshelfConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
import "@/styles/pages/bookshelf.css";

const { name, description, categories, featured = [] } = bookshelfConfig;

// 展平所有词条（含子分组）
const allEntries = categories.flatMap((cat) => [
	...cat.entries.map((e) => ({ ...e, categoryId: cat.id, categoryName: cat.name })),
	...(cat.subgroups ?? []).flatMap((sub) =>
		sub.entries.map((e) => ({ ...e, categoryId: cat.id, categoryName: cat.name, subgroup: sub.name })),
	),
]);
const featuredEntries = allEntries.filter((e) => featured.includes(e.id));
const featuredCount = Math.min(featuredEntries.length, 6);
const bookTotal = allEntries.length;

const wikiTitle = name;
const wikiDescription = description || "";
---

<MainGridLayout title={wikiTitle} description={wikiDescription} hasOwnH1={true}>
	<div class="bookshelf-page" data-bk-root>
		{/* 首屏 Opening 幕布（JS 负责揭开） */}
		<div class="bookshelf-intro" data-bk-intro aria-hidden="true">
			<div class="bookshelf-intro__panels">
				<div class="bookshelf-intro__panel bookshelf-intro__panel--left" data-bk-band></div>
				<div class="bookshelf-intro__panel bookshelf-intro__panel--right" data-bk-band></div>
			</div>
			<div class="bookshelf-intro__title">
				<span class="bookshelf-intro__en" data-bk-intro-en>ETERNAL</span>
				<span class="bookshelf-intro__zh" data-bk-intro-title>{wikiTitle}</span>
			</div>
		</div>

		<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
				<header class="bookshelf__header" data-bk-header>
					<div class="bookshelf__title-row">
						<Icon name="material-symbols:menu-book-rounded" class="bookshelf__logo" />
						<PageTitle title={wikiTitle} variant="stacked" />
					</div>
					<p class="bookshelf__description">{wikiDescription}</p>
					<div class="bookshelf__stats">
						<span>{categories.length} {i18n(I18nKey.bookshelfCategories)}</span>
						<span class="bookshelf__stats-dot">·</span>
						<span>{bookTotal} {i18n(I18nKey.bookshelfEntries)}</span>
					</div>
				</header>

				{
					featuredEntries.length > 0 && (
						<section class="bookshelf__section" data-bk-section>
							<div class="bookshelf__section-head">
								<span class="bookshelf__section-en" data-bk-en>FEATURED</span>
								<h2 class="bookshelf__section-title">
									<Icon name="material-symbols:star-rounded" />
									{i18n(I18nKey.bookshelfFeatured)}
								</h2>
							</div>
							<div class="bookshelf__featured" data-bk-cards>
								{featuredEntries.slice(0, featuredCount).map((entry) => (
									<a
										href={url(`/bookshelf/entries/${entry.categoryId}/${encodeURIComponent(entry.title)}/`)}
										class="bookshelf__featured-card"
										data-bk-card
									>
										<span class="bookshelf__featured-cat">{entry.categoryName}</span>
										<span class="bookshelf__featured-title">{entry.title}</span>
										<span class="bookshelf__featured-summary">{entry.summary}</span>
									</a>
								))}
							</div>
						</section>
					)
				}

				<section class="bookshelf__section" data-bk-section>
					<div class="bookshelf__section-head">
						<span class="bookshelf__section-en" data-bk-en>THE SHELF</span>
						<h2 class="bookshelf__section-title">
							<Icon name="material-symbols:library-books" />
							{i18n(I18nKey.bookshelfBrowse)}
						</h2>
					</div>

					<div class="bookshelf__shelf" data-bk-cards>
						{categories.map((cat, i) => (
							<article class="bookshelf__book" data-bk-card style={`--book-index: ${i}`}>
								<a
									href={url(`/bookshelf/category/${cat.id}/`)}
									class="bookshelf__book-cover"
								>
									<Icon name={cat.icon} class="bookshelf__book-icon" />
									<span class="bookshelf__book-title">{cat.name}</span>
									<span class="bookshelf__book-summary">{cat.summary}</span>
									<span class="bookshelf__book-count">{allEntries.filter((e) => e.categoryId === cat.id).length}</span>
								</a>

								<ul class="bookshelf__book-entries">
									{cat.entries.slice(0, 4).map((entry) => (
										<li>
											<a href={url(`/bookshelf/entries/${cat.id}/${encodeURIComponent(entry.title)}/`)}>
												{entry.title}
											</a>
										</li>
									))}
									{(cat.subgroups ?? []).map((sub) =>
										sub.entries.slice(0, 4).map((entry) => (
											<li class="bookshelf__book-entry--sub" title={sub.name}>
												<a href={url(`/bookshelf/entries/${cat.id}/${encodeURIComponent(entry.title)}/`)}>
													{entry.title}
												</a>
											</li>
										)),
									)}
									{
										allEntries.filter((e) => e.categoryId === cat.id).length > 4 && (
											<li class="bookshelf__book-more">
												<a href={url(`/bookshelf/category/${cat.id}/`)}>
													{i18n(I18nKey.more)}… ({allEntries.filter((e) => e.categoryId === cat.id).length})
												</a>
											</li>
										)
									}
								</ul>
							</article>
						))}
					</div>
				</section>

				<section class="bookshelf__section" data-bk-section>
					<div class="bookshelf__section-head">
						<span class="bookshelf__section-en" data-bk-en>SURPRISE</span>
						<button type="button" class="bookshelf__random" data-bookshelf-random>
							<Icon name="material-symbols:casino" />
							{i18n(I18nKey.bookshelfRandom)}
						</button>
					</div>
				</section>
			</div>
		</div>
	</div>

	<script>
		import { mountBookshelfAnimations } from "@/utils/bookshelf-home-animation";

		// 收集所有词条链接
		document.querySelectorAll("a[href*='/bookshelf/entries/']").forEach((a) => {
			a.setAttribute("data-bookshelf-entry-url", a.getAttribute("href"));
		});

		function randomEntry() {
			const links = document.querySelectorAll("[data-bookshelf-entry-url]");
			if (links.length === 0) return;
			const idx = Math.floor(Math.random() * links.length);
			window.location.href = links[idx].getAttribute("data-bookshelf-entry-url");
		}

		function boot() {
			const btn = document.querySelector("[data-bookshelf-random]");
			if (btn && !btn.dataset.bound) {
				btn.dataset.bound = "true";
				btn.addEventListener("click", randomEntry);
			}
			mountBookshelfAnimations();
		}

		boot();
		document.addEventListener("astro:page-load", boot);
	</script>
</MainGridLayout>
