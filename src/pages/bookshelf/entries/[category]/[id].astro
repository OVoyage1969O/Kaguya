---
import { getCollection, render } from "astro:content";
import BookshelfDust from "@components/bookshelf/BookshelfDust.svelte";
import Icon from "@components/common/Icon.astro";
import EntryIntro from "@/components/bookshelf/EntryIntro.astro";
import Infobox from "@/components/bookshelf/Infobox.astro";
import Navbox from "@/components/bookshelf/Navbox.astro";
import Notices from "@/components/bookshelf/Notices.astro";
import StatRadar from "@/components/bookshelf/StatRadar.astro";
import { bookshelfConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getBookshelfCatalogue,
	resolveBookshelfAsset,
} from "@/utils/bookshelf-data";
import { url } from "@/utils/url-utils";
import "@/styles/pages/bookshelf-entry.css";
import "@/styles/components/bookshelf-navbox.css";
import "@/styles/components/bookshelf-infobox.css";
import "@/styles/components/bookshelf-notices.css";
import "@/styles/components/bookshelf-stat-radar.css";

export async function getStaticPaths() {
	const entries = await getCollection("bookshelf");
	return entries.map((entry) => ({
		params: { category: entry.data.categoryId, id: entry.data.title },
	}));
}

const { category, id } = Astro.params;
const entry = (await getCollection("bookshelf")).find(
	(e) => e.data.title === id && e.data.categoryId === category,
);

if (!entry) {
	return Astro.redirect(url("/bookshelf/"));
}

const data = entry.data;
const { Content } = await render(entry);
const catalogue = await getBookshelfCatalogue();
const currentVolume = catalogue.find((c) => c.id === category);
const volumeItems = currentVolume?.items ?? [];
const currentIdx = volumeItems.findIndex((i) => i.title === data.title);
const currentEnriched = currentIdx >= 0 ? volumeItems[currentIdx] : undefined;
const prevEntry = currentIdx > 0 ? volumeItems[currentIdx - 1] : undefined;
const nextEntry =
	currentIdx >= 0 && currentIdx < volumeItems.length - 1
		? volumeItems[currentIdx + 1]
		: undefined;

const wikiTitle = `${data.title} - ${bookshelfConfig.name}`;
const bgOpacity = Math.min(data.background?.opacity ?? 0.12, 0.16);
const bgUrl = data.background?.image
	? resolveBookshelfAsset(data.background.image)
	: "";
---

<MainGridLayout title={wikiTitle} description={data.summary} hasOwnH1={true}>
	<div
		class:list={[
			"bookshelf-entry",
			`bookshelf-entry--${category}`,
			bgUrl ? "bookshelf-entry--has-bg" : "",
		]}
		data-bk-entry
		style={bgUrl
			? `--bk-bg-image: url('${bgUrl}'); --bk-bg-opacity: ${bgOpacity};`
			: undefined}
	>
		<BookshelfDust client:only="svelte" />
		{data.intro && <EntryIntro intro={data.intro} storageKey={data.title} />}
		{bgUrl && <div class="bookshelf-entry__bg" aria-hidden="true"></div>}

		<div class="bookshelf-entry__sheet">
			<!-- 顶部馆藏卷眉签 -->
			<div class="bookshelf-entry__masthead" data-bk-intro>
				<div class="bookshelf-entry__folio-bar">
					<a
						class="bookshelf-entry__vol-pill"
						href={currentVolume?.href || url("/bookshelf/")}
					>
						<i class="bookshelf-entry__vol-dot" aria-hidden="true"></i>
						<span>
							{currentVolume
								? `${currentVolume.volumeNumeral} · ${currentVolume.name}`
								: data.categoryName}
						</span>
					</a>
					<span class="bookshelf-entry__folio-code" lang="en">
						{currentEnriched
							? `FOLIO NO. ${currentEnriched.folio} · ${currentEnriched.groupLabel}`
							: "ARCHIVE ENTRY"}
					</span>
				</div>

				<header class="bookshelf-entry__header">
					<h1 class="bookshelf-entry__title">{data.title}</h1>
					{data.summary && (
						<p class="bookshelf-entry__summary">{data.summary}</p>
					)}
				</header>
			</div>

			{data.notices && data.notices.length > 0 && (
				<div data-bk-intro>
					<Notices notices={data.notices} />
				</div>
			)}

			<!-- 文学题记栏（Epigraph） -->
			{data.quote && (
				<blockquote class="bookshelf-entry__quote" data-bk-intro>
					<span class="bookshelf-entry__quote-mark" aria-hidden="true">“</span>
					<p class="bookshelf-entry__quote-text">{data.quote}</p>
					{data.quoteBy && (
						<cite class="bookshelf-entry__quote-by">
							{data.quoteBy.replace(/^——\s*/, "— ")}
						</cite>
					)}
				</blockquote>
			)}

			<article class="bookshelf-entry__body bookshelf-entry__markdown custom-md">
				{data.infobox ? (
					<Infobox
						title={data.infobox.title}
						image={
							data.infobox.image
								? resolveBookshelfAsset(data.infobox.image)
								: undefined
						}
						imageAlt={data.infobox.imageAlt}
						groups={data.infobox.groups}
						stats={data.stats}
					/>
				) : (
					data.stats &&
					data.stats.values.length >= 3 && (
						<StatRadar
							title={data.stats.title}
							max={data.stats.max}
							values={data.stats.values}
						/>
					)
				)}

				<Content />
			</article>

			{data.gallery && data.gallery.length > 0 && (
				<div class="bookshelf-entry__gallery">
					{data.gallery.map((src) => (
						<figure class="bookshelf-entry__gallery-item">
							<img src={resolveBookshelfAsset(src)} alt="" loading="lazy" />
						</figure>
					))}
				</div>
			)}

			<!-- 同卷前后翻页导览 -->
			{(prevEntry || nextEntry) && (
				<nav class="bookshelf-entry__sequel" aria-label="同卷相邻词条">
					{prevEntry ? (
						<a
							class="bookshelf-entry__sequel-link bookshelf-entry__sequel-link--prev"
							href={prevEntry.href}
						>
							<span class="bookshelf-entry__sequel-label">
								<Icon name="material-symbols:arrow-back-rounded" />
								<span>上一篇 · NO. {prevEntry.folio}</span>
							</span>
							<strong class="bookshelf-entry__sequel-title">
								{prevEntry.title}
							</strong>
						</a>
					) : (
						<div></div>
					)}
					{nextEntry ? (
						<a
							class="bookshelf-entry__sequel-link bookshelf-entry__sequel-link--next"
							href={nextEntry.href}
						>
							<span class="bookshelf-entry__sequel-label">
								<span>NO. {nextEntry.folio} · 下一篇</span>
								<Icon name="material-symbols:arrow-forward-rounded" />
							</span>
							<strong class="bookshelf-entry__sequel-title">
								{nextEntry.title}
							</strong>
						</a>
					) : (
						<div></div>
					)}
				</nav>
			)}

			<Navbox currentCategory={category} currentId={id} />

			<footer class="bookshelf-entry__footer">
				<a href={url("/bookshelf/")} class="bookshelf-entry__back">
					<Icon name="material-symbols:arrow-back-rounded" />
					<span>{i18n(I18nKey.bookshelfBack)}</span>
				</a>
			</footer>
		</div>
	</div>

	<script>
		import { riseIntoPlace } from "@/utils/editorial-motion";

		function bootEntryMotion() {
			const root = document.querySelector<HTMLElement>("[data-bk-entry]");
			if (!root || root.dataset.bkMounted) return;
			root.dataset.bkMounted = "true";
			if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

			root
				.querySelectorAll<HTMLElement>("[data-bk-intro]")
				.forEach((el, idx) => {
					riseIntoPlace(el, 50 + idx * 70, 16);
				});

			const infobox = root.querySelector<HTMLElement>(".bk-infobox");
			if (infobox) riseIntoPlace(infobox, 160, 18);
		}

		bootEntryMotion();
		document.addEventListener("astro:page-load", bootEntryMotion);
		window.swup?.hooks?.on("page:view", bootEntryMotion);
	</script>
</MainGridLayout>
