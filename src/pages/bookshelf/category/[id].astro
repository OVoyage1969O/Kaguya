---
import Icon from "@components/common/Icon.astro";
import { bookshelfConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	type EnrichedBookshelfItem,
	getBookshelfCatalogue,
} from "@/utils/bookshelf-data";
import { url } from "@/utils/url-utils";
import "@/styles/pages/bookshelf-home.css";

export function getStaticPaths() {
	return bookshelfConfig.categories.map((category) => ({
		params: { id: category.id },
	}));
}

const catalogue = await getBookshelfCatalogue();
const volume = catalogue.find((category) => category.id === Astro.params.id)!;

const groupedMap = new Map<string, EnrichedBookshelfItem[]>();
for (const item of volume.items) {
	const key = item.groupLabel || "收录词条";
	if (!groupedMap.has(key)) groupedMap.set(key, []);
	groupedMap.get(key)!.push(item);
}
const groups = [...groupedMap.entries()];
const peopleCount = volume.items.filter((i) => i.person).length;
---

<MainGridLayout
	title={`${volume.name} - ${bookshelfConfig.name}`}
	description={volume.editorialSynopsis}
	hasOwnH1={true}
>
	<div class={`vol-page vol-page--${volume.id}`} data-vol-page>
		<!-- 顶部丸窓专刊舞台 -->
		<header class="vol-stage">
			<div class="vol-stage__bg" aria-hidden="true">
				<img src={volume.coverResolved} alt="" width="1200" height="896" />
				<div class="vol-stage__wash"></div>
			</div>

			<div class="vol-stage__top">
				<a class="vol-stage__back" href={url(`/bookshelf/#world-${volume.id}`)}>
					<Icon name="material-symbols:arrow-back-rounded" />
					<span>返回丸窓藏书室</span>
				</a>
				<span class="vol-stage__era" lang="en">
					{volume.volumeRoman} · {volume.era}
				</span>
			</div>

			<div class="vol-stage__body">
				<div class="vol-stage__copy" data-vol-intro>
					<div class="vol-stage__eyebrow">
						<span class="vol-stage__dot" aria-hidden="true"></span>
						<span>{volume.volumeNumeral}</span>
						<span aria-hidden="true">·</span>
						<span lang="en">{volume.english}</span>
					</div>
					<h1 class="vol-stage__title">{volume.name}</h1>
					<p class="vol-stage__synopsis">{volume.editorialSynopsis}</p>

					<dl class="vol-stage__metrics">
						<div>
							<dt>收录词条</dt>
							<dd>{volume.items.length} 篇</dd>
						</div>
						{peopleCount > 0 && (
							<div>
								<dt>人物档案</dt>
								<dd>{peopleCount} 位</dd>
							</div>
						)}
						<div>
							<dt>巡礼地标</dt>
							<dd>{volume.locale}</dd>
						</div>
					</dl>

					<div class="vol-stage__actions">
						<a
							class="vol-stage__search-btn"
							href={url(`/bookshelf/?category=${volume.id}#catalogue`)}
						>
							<Icon name="material-symbols:search-rounded" />
							<span>在本卷总目中检索</span>
						</a>
					</div>
				</div>

				<!-- 圆形丸窓装裱景框 -->
				<div class="vol-stage__aperture" data-vol-intro>
					<svg class="vol-stage__rings" viewBox="0 0 360 360" aria-hidden="true">
						<circle class="vol-stage__ring vol-stage__ring--outer" cx="180" cy="180" r="172" />
						<circle class="vol-stage__ring vol-stage__ring--inner" cx="180" cy="180" r="158" />
					</svg>
					<div class="vol-stage__circle">
						<img
							src={volume.coverResolved}
							alt={`${volume.name}卷首插图`}
							width="1200"
							height="896"
							loading="eager"
							decoding="async"
						/>
						<span class="vol-stage__locale">{volume.locale}</span>
					</div>
				</div>

				<p class="vol-stage__poem" aria-hidden="true">
					{volume.poetry[0]}
				</p>
			</div>
		</header>

		{groups.length > 0 ? (
			<div class="vol-page__chapters">
				{groups.map(([groupName, groupItems], gIdx) => (
					<section class="vol-chapter" data-vol-reveal>
						{groups.length > 1 && (
							<header class="vol-chapter__head">
								<span class="vol-chapter__num">
									{String(gIdx + 1).padStart(2, "0")}
								</span>
								<h2>{groupName}</h2>
								<span class="vol-chapter__count">{groupItems.length} 篇</span>
							</header>
						)}
						<div class="vol-grid">
							{groupItems.map((entry, idx) => (
								<a
									class:list={[
										"vol-card",
										entry.image ? "vol-card--illustrated" : "",
									]}
									href={entry.href}
									style={`--stagger:${idx}`}
								>
									{entry.image && (
										<div class="vol-card__thumb">
											<img
												src={entry.image}
												alt=""
												width="160"
												height="200"
												loading="lazy"
												decoding="async"
											/>
										</div>
									)}
									<div class="vol-card__body">
										<div class="vol-card__meta">
											<span class="vol-card__folio">NO. {entry.folio}</span>
											<span class="vol-card__tag">{entry.groupLabel}</span>
										</div>
										<h3 class="vol-card__title">
											<span>{entry.title}</span>
											<Icon name="material-symbols:arrow-outward-rounded" />
										</h3>
										<p class="vol-card__desc">
											{entry.quote ? `「${entry.quote}」` : entry.summary}
										</p>
									</div>
								</a>
							))}
						</div>
					</section>
				))}
			</div>
		) : (
			<p class="vol-empty">这一卷暂未收录词条。</p>
		)}

		<nav class="vol-switcher" aria-label="切换其他世界分卷">
			<span class="vol-switcher__label">同馆其他分卷</span>
			<div class="vol-switcher__list">
				{catalogue.map((cat) => (
					<a
						class={`vol-switcher__tab vol-switcher__tab--${cat.id}`}
						href={cat.href}
						aria-current={volume.id === cat.id ? "page" : undefined}
					>
						<span class="vol-switcher__num">{cat.volumeNumeral}</span>
						<span class="vol-switcher__name">{cat.name}</span>
						<sup>{cat.items.length}</sup>
					</a>
				))}
			</div>
		</nav>
	</div>

	<script>
		import { riseIntoPlace } from "@/utils/editorial-motion";

		function bootVolumePage() {
			const root = document.querySelector<HTMLElement>("[data-vol-page]");
			if (!root || root.dataset.volMounted) return;
			root.dataset.volMounted = "true";
			if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

			root
				.querySelectorAll<HTMLElement>("[data-vol-intro]")
				.forEach((el, idx) => {
					riseIntoPlace(el, 60 + idx * 90, 18);
				});

			const observer = new IntersectionObserver(
				(entries) => {
					entries
						.filter((e) => e.isIntersecting)
						.forEach((entry, idx) => {
							observer.unobserve(entry.target);
							riseIntoPlace(entry.target as HTMLElement, idx * 70, 18);
						});
				},
				{ threshold: 0.08 },
			);
			root
				.querySelectorAll<HTMLElement>("[data-vol-reveal]")
				.forEach((el) => observer.observe(el));
		}

		bootVolumePage();
		document.addEventListener("astro:page-load", bootVolumePage);
		window.swup?.hooks?.on("page:view", bootVolumePage);
	</script>
</MainGridLayout>
