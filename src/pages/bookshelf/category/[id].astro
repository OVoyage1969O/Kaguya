---
import Icon from '@components/common/Icon.astro';
import { bookshelfConfig } from '@/config';
import MainGridLayout from '@/layouts/MainGridLayout.astro';
import { getBookshelfCatalogue } from '@/utils/bookshelf-data';
import { url } from '@/utils/url-utils';
import '@/styles/pages/bookshelf-home.css';
export function getStaticPaths(){return bookshelfConfig.categories.map(category=>({params:{id:category.id}}));}
const catalogue=await getBookshelfCatalogue();
const volume=catalogue.find(category=>category.id===Astro.params.id)!;
---
<MainGridLayout title={`${volume.name} - ${bookshelfConfig.name}`} description={volume.summary} hasOwnH1={true}>
  <div class={`atlas atlas-category atlas-category--${volume.id}`}>
    <a class="atlas-text-link" href={url('/bookshelf/#worlds')}><Icon name="material-symbols:arrow-back-rounded" />返回世界分卷</a>
    <header class="atlas-category__hero">
      <div><h1>{volume.name}</h1><p>{volume.summary}</p><p>{volume.items.length} 个已收录词条</p><a class="atlas-text-link" href={url(`/bookshelf/?category=${volume.id}#catalogue`)}>在这一卷中搜索 <Icon name="material-symbols:search-rounded" /></a></div>
      {volume.cover&&<img src={volume.cover} alt={`${volume.name}的封面`} width="720" height="480" />}
    </header>
    <div class="atlas-entry-grid">{volume.items.map(entry=><a class="atlas-entry" href={entry.href}><h3>{entry.title}<Icon name="material-symbols:arrow-outward-rounded" /></h3><p>{entry.summary||'打开词条，继续阅读。'}</p></a>)}</div>
    {!volume.items.length&&<p class="atlas-empty">这一卷暂未收录词条。</p>}
    <nav class="atlas-category__nav" aria-label="其他世界分卷">{catalogue.map(category=><a href={category.href} aria-current={volume.id===category.id?'page':undefined}>{category.name}</a>)}</nav>
  </div>
</MainGridLayout>
