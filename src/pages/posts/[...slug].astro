---
import { render } from "astro:content";
import * as path from "node:path";
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import Markdown from "@components/common/Markdown.astro";
import VisitorCount from "@components/common/VisitorCount.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import SharePoster from "@components/misc/SharePoster.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import "@/styles/components/post-hero.css";
import { getSortedPosts } from "@utils/content-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagUrl,
	removeFileExtension,
} from "@utils/url-utils";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import PostFooterActions from "@/components/misc/PostFooterActions.astro";
import RelatedPosts from "@/components/misc/RelatedPosts.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { homeConfig } from "@/config/homeConfig";
import { siteConfig } from "@/config/siteConfig";
import { formatDateI18n, formatDateToYYYYMMDD } from "@/utils/date-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const bannerPostMeta = {
	title: entry.data.title,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const posterFallbackCoverUrl = coverImageConfig.randomCoverImage.fallback
	? url(coverImageConfig.randomCoverImage.fallback)
	: null;

let posterCoverUrl = processedImage;
if (processedImage) {
	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);
	if (isLocal) {
		const basePath = getFileDirFromPath(entry.filePath || "");
		const files = import.meta.glob<ImageMetadata>(
			"../../**/*.{png,jpg,jpeg,webp,avif,gif}",
			{
				import: "default",
			},
		);
		let normalizedPath = path
			.normalize(path.join("../../", basePath, processedImage))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterCoverUrl = img.src;
		}
	}
}

// 处理头像URL
let posterAvatarUrl: string | null = homeConfig.avatar || null;
if (posterAvatarUrl) {
	const isLocalAvatar = !(
		posterAvatarUrl.startsWith("/") ||
		posterAvatarUrl.startsWith("http") ||
		posterAvatarUrl.startsWith("https") ||
		posterAvatarUrl.startsWith("data:")
	);
	if (isLocalAvatar) {
		const files = import.meta.glob<ImageMetadata>(
			"../../**/*.{png,jpg,jpeg,webp,avif,gif}",
			{
				import: "default",
			},
		);
		const normalizedPath = path
			.normalize(path.join("../../", posterAvatarUrl))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterAvatarUrl = img.src;
		}
	}
}

dayjs.extend(utc);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultStructuredImageUrl = new URL(siteConfig.defaultOgImage, Astro.site)
	.href;
const structuredImageUrl = posterCoverUrl
	? new URL(posterCoverUrl, Astro.site).href
	: defaultStructuredImageUrl;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": ["BlogPosting", "TechArticle"],
	"@id": canonicalUrl,
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	articleSection: entry.data.category || i18n(I18nKey.uncategorized),
	wordCount: remarkPluginFrontmatter.words,
	image: structuredImageUrl,
	author: { "@id": `${Astro.site}#person` },
	url: canonicalUrl,
	isPartOf: { "@id": `${Astro.site}#website` },
	publisher: {
		"@type": "Organization",
		"@id": `${Astro.site}#organization`,
		name: siteConfig.title,
		url: new URL("/", Astro.site).href,
		logo: {
			"@type": "ImageObject",
			"@id": `${Astro.site}#logo`,
			url: defaultStructuredImageUrl,
		},
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated && {
		dateModified: formatDateToYYYYMMDD(entry.data.updated),
	}),
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalUrl,
	},
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: siteConfig.title,
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: entry.data.category || i18n(I18nKey.navPosts),
			item: new URL(
				`/archive/?category=${encodeURIComponent(entry.data.category || "")}`,
				Astro.site,
			).href,
		},
		{
			"@type": "ListItem",
			position: 3,
			name: entry.data.title,
			item: canonicalUrl,
		},
	],
};
const serializedBreadcrumbJsonLd = JSON.stringify(breadcrumbJsonLd).replace(
	/</g,
	"\\u003c",
);
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  bannerPostMeta={bannerPostMeta}
  articleMeta={{
    published: entry.data.published,
    updated: entry.data.updated,
    author: entry.data.author || homeConfig.name,
    category: entry.data.category || undefined,
    tags: entry.data.tags,
  }}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={serializedJsonLd}
  />
	<script
		slot="head"
		is:inline
		type="application/ld+json"
		set:html={serializedBreadcrumbJsonLd}
	/>
  {/* 章节开篇：卷名、标题、导语与一条元信息带 */}
  {(() => {
    const lastModified = dayjs(entry.data.updated || entry.data.published);
    const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
    const tags = (entry.data.tags || []).map((tag) => tag.trim()).filter(Boolean);
    return (
      <header class="post-hero post-opener onload-animation">
        <a href={getCategoryUrl(entry.data.category || null)} class="post-opener__volume">
          {entry.data.category || i18n(I18nKey.uncategorized)}
        </a>
        <h1
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class="post-hero__title post-opener__title"
        >
          {entry.data.title}
        </h1>
        {entry.data.description && entry.data.description.trim() !== entry.data.title.trim() && (
          <p class="post-opener__lede">{entry.data.description}</p>
        )}

        <dl class="post-opener__facts">
          <div class="post-opener__fact">
            <dt>发布于</dt>
            <dd><time datetime={entry.data.published.toISOString()}>{formatDateI18n(entry.data.published)}</time></dd>
          </div>
          {entry.data.updated && (
            <div class="post-opener__fact">
              <dt>更新于</dt>
              <dd><time datetime={entry.data.updated.toISOString()}>{formatDateI18n(entry.data.updated)}</time></dd>
            </div>
          )}
          <div class="post-opener__fact">
            <dt>篇幅</dt>
            <dd>{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}，约 {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</dd>
          </div>
          <div class="post-opener__fact post-hero__views">
            <dt>浏览</dt>
            <dd><VisitorCount id={entry.id} compact /></dd>
          </div>
          {tags.length > 0 && (
            <div class="post-opener__fact post-opener__fact--tags">
              <dt>标签</dt>
              <dd>
                {tags.map((tag) => (
                  <a href={getTagUrl(tag)} class="post-opener__tag">{tag}</a>
                ))}
              </dd>
            </div>
          )}
          {siteConfig.sharePoster && (
            <div class="post-opener__fact post-opener__fact--action post-hero__share">
              <dt class="sr-only">分享</dt>
              <dd><SharePoster
                client:only="svelte"
                title={entry.data.title}
                author={homeConfig.name}
                description={entry.data.description || entry.data.title}
                pubDate={formatDateToYYYYMMDD(entry.data.published)}
                coverImage={posterCoverUrl}
                fallbackCoverImage={posterFallbackCoverUrl}
                url={Astro.url.href}
                siteTitle={siteConfig.title}
                avatar={posterAvatarUrl}
              /></dd>
            </div>
          )}
        </dl>

        {siteConfig.showLastModified && (
          <p
            id="outdated-info"
            class="post-opener__notice hidden"
            data-date={lastModified.toISOString()}
            data-threshold={outdatedThreshold}
          >
            <Icon name="material-symbols:history-rounded" class="post-opener__notice-icon" />
            <span>
              {i18n(I18nKey.lastModifiedPrefix)}{lastModified.format("YYYY-MM-DD")}
              <span id="days-ago-text-intro" class="outdated-days" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
              <span id="outdated-warning-intro" class="outdated-warning hidden">，{i18n(I18nKey.lastModifiedOutdated)}</span>
            </span>
          </p>
        )}
      </header>
    );
  })()}

  {/* Layer 3: Cover image */}
  {coverImageConfig.enableInPost && posterCoverUrl && (
    <div class="post-cover mb-2">
      <img
        src={posterCoverUrl}
        alt={`${entry.data.title} - ${i18n(I18nKey.coverImageAltSuffix)}`}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div id="post-container" class="card-base z-10 px-3 pb-4 pt-0 relative w-full">
      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          <PostFooterActions
            title={entry.data.title}
            published={entry.data.published}
            id={entry.id}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
          />
          <RelatedPosts
            currentId={entry.id}
            tags={entry.data.tags}
            category={entry.data.category || undefined}
          />
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          <PostFooterActions
            title={entry.data.title}
            published={entry.data.published}
            id={entry.id}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
          />
          <RelatedPosts
            currentId={entry.id}
            tags={entry.data.tags}
            category={entry.data.category || undefined}
          />
        </>
      )}
    </div>
  </div>

  <script>
    import dayjs from "dayjs";

    function checkOutdated() {
      const info = document.getElementById('outdated-info');
      if (!info) return;
      const lastModified = dayjs(info.dataset.date);
      const daysDiff = dayjs().diff(lastModified, "day");
      const threshold = Number(info.dataset.threshold);

      if (daysDiff >= threshold) {
        info.classList.remove('hidden');
        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text-intro');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }
          const warningEl = document.getElementById('outdated-warning-intro');
          if (warningEl) warningEl.classList.remove('hidden');
        }
      }
    }

    document.addEventListener("astro:page-load", checkOutdated);
  </script>

  {/* 续读：左侧是较新的一篇，右侧是较早的一篇（文章按发布时间倒序） */}
  <nav class="post-sequel" aria-label="继续阅读">
    <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")} class="post-sequel__link post-sequel__link--prev">
      <span class="post-sequel__label">
        <Icon name="material-symbols:arrow-back-rounded" class="post-sequel__icon" />
        {entry.data.nextSlug ? "较新一篇" : i18n(I18nKey.home)}
      </span>
      <span class="post-sequel__title">{entry.data.nextTitle || "回到永远邸"}</span>
    </a>
    <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")} class="post-sequel__link post-sequel__link--next">
      <span class="post-sequel__label">
        {entry.data.prevSlug ? "较早一篇" : i18n(I18nKey.home)}
        <Icon name="material-symbols:arrow-forward-rounded" class="post-sequel__icon" />
      </span>
      <span class="post-sequel__title">{entry.data.prevTitle || "回到永远邸"}</span>
    </a>
  </nav>

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
</MainGridLayout>
