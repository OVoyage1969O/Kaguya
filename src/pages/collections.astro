---
import Icon from '@components/common/Icon.astro';
import PageTitle from '@/components/common/PageTitle.astro';
import ToolGrid from '@/components/common/ToolGrid.astro';
import { collectionsApiConfig, siteConfig } from '@/config';
import I18nKey from '@/i18n/i18nKey';
import { i18n } from '@/i18n/translation';
import MainGridLayout from '@/layouts/MainGridLayout.astro';
import '@/styles/collections.css';
if (!siteConfig.pages.collections) return Astro.redirect('/404/');
const title = collectionsApiConfig.title || i18n(I18nKey.collections);
const description = collectionsApiConfig.description || i18n(I18nKey.collectionsDescription);
const enabledGroups = collectionsApiConfig.apis.map(group=>({...group,items:group.items.filter(item=>item.enabled)})).filter(group=>group.items.length>0);
const enabledApisCount = enabledGroups.reduce((count,group)=>count+group.items.length,0);
---
<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 md:px-9 py-6 relative w-full">
      <div class="mb-8"><PageTitle title={title} variant="stacked" /></div>
      {enabledApisCount>0 && enabledGroups.length>1 && <div class="tools-tab-wrapper">
        <div class="tools-tab-pill" data-tools-tab-nav>
          <div class="tools-tab-indicator" data-tools-tab-indicator></div>
          <button data-tools-tab="all" class="tools-tab-btn tools-tab-btn-active">{i18n(I18nKey.all)}<span class="tools-tab-badge">{enabledApisCount}</span></button>
          {enabledGroups.map(group=><button data-tools-tab={group.category} class="tools-tab-btn tools-tab-btn-inactive">{group.category}<span class="tools-tab-badge">{group.items.length}</span></button>)}
        </div>
      </div>}
      {enabledApisCount>0 ? <div>
        <div data-tools-section="all">
          {enabledGroups.map(group=><div class="tools-category-group mt-8 first:mt-0">
            <div class="flex items-center gap-3 mb-5"><div class="flex items-center gap-2"><Icon name="material-symbols:label-outline" class="text-lg" /><span class="text-base font-bold">{group.category}</span></div><span class="text-xs text-(--content-meta)">{group.items.length}</span><div class="flex-1 h-px bg-(--line-divider)" /></div>
            <ToolGrid category={group.category} items={group.items} variant="all" />
          </div>)}
        </div>
        {enabledGroups.map(group=><div data-tools-section={group.category} class="hidden"><ToolGrid category={group.category} items={group.items} variant="tab" /></div>)}
      </div> : <div class="text-center py-16"><Icon name="material-symbols:bookmark-outline" class="text-5xl mb-4" /><p>{i18n(I18nKey.collectionsEmpty)}</p></div>}
    </div>
  </div>
  <script>
    import { initCollections } from '@/utils/collections-controller';
    initCollections();
  </script>
</MainGridLayout>
