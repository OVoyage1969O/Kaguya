---
// A standalone scene intentionally has no blog shell, controls overlay or menu.
---
<!doctype html>
<html lang="zh-CN" class="kuonji-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202a32" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cpath fill='%239caaa7' d='M5 20 20 5l15 15v16H5z'/%3E%3Cpath fill='%23202a32' d='M16 24h8v12h-8z'/%3E%3C/svg%3E" />
    <meta name="description" content="久远寺宅：可旋转与缩放的三渲二微缩庭院。" />
    <title>久远寺宅 · 微缩庭院</title>
    <noscript><style>.kuonji-opening{display:none !important}</style></noscript>
  </head>
  <body>
    <div class="kuonji-opening" data-kuonji-intro aria-hidden="true">
      <span class="kuonji-opening__leaf"></span>
      <span class="kuonji-opening__leaf"></span>
      <div class="kuonji-opening__mark">
        <span class="kuonji-opening__kicker">THE ETERNAL MANSION</span>
        <span class="kuonji-opening__mask"><strong>久远寺宅</strong></span>
        <span class="kuonji-opening__sub">入宅 · 微缩庭院</span>
      </div>
      <span class="kuonji-opening__hint">推开门扉 · 请稍候</span>
    </div>
    <script is:inline>
      // 场景模块加载失败或迟迟未就绪时，也要把门打开，避免开屏幕布卡住页面。
      window.setTimeout(function () {
        document.documentElement.classList.add("is-kuonji-open");
      }, 7000);
    </script>
    <main id="kuonji-scene" aria-label="久远寺宅微缩庭院"></main>
    <noscript>请启用 JavaScript 查看三维场景。</noscript>
    <script>
      import { mountKuonji } from '@/components/features/kuonji-diorama/scene';
      let cleanup: (() => void) | undefined;
      const intro = document.querySelector<HTMLElement>('[data-kuonji-intro]');
      const openedAt = performance.now();
      const openIntro = () => {
        document.documentElement.classList.add('is-kuonji-open');
        window.setTimeout(() => { intro?.remove(); }, 3800);
      };
      // 幕布与书架的开幕一致：先等场景就绪，再拉帘，避免提前露出空屏。
      const revealScene = () => {
        window.setTimeout(openIntro, Math.max(0, 650 - (performance.now() - openedAt)));
      };
      const mount=()=>{
        const host=document.getElementById('kuonji-scene');
        if(!host||host.dataset.sceneReady)return;
        try {cleanup=mountKuonji(host);revealScene();} catch(error) {
          console.error('Unable to initialize Kuonji scene',error);
          host.textContent='三维场景未能加载，请确认浏览器已开启 WebGL / 硬件加速后刷新。';
          revealScene();
        }
      };
      mount();
      document.addEventListener('astro:page-load',mount);
      document.addEventListener('astro:before-swap',()=>{cleanup?.();cleanup=undefined;});
      window.addEventListener('pagehide',()=>{cleanup?.();cleanup=undefined;});
      window.addEventListener('pageshow',mount);
    </script>
  </body>
</html>
<style is:global>
  html.kuonji-page,.kuonji-page body {margin:0;width:100%;height:100%;overflow:hidden;background:#202a32;scrollbar-gutter:auto;}
  #kuonji-scene {width:100%;height:100dvh;display:grid;place-items:center;color:#cad4db;font:14px/1.7 serif;}
  #kuonji-scene canvas {display:block;width:100%;height:100%;touch-action:none;cursor:grab;outline:none;}
  #kuonji-scene canvas:active {cursor:grabbing;}
  #kuonji-scene canvas:focus-visible {outline:1px solid #8899a8;outline-offset:-2px;}

  /* 入宅开屏：与「进入书架」同源的开幕幕布 —— 两扇门叶合拢，标题自门缝升起，随后向两侧开启。 */
  .kuonji-opening {position:fixed;inset:0;z-index:60;overflow:hidden;pointer-events:none;}
  .kuonji-opening__leaf {position:absolute;top:0;bottom:0;left:0;width:50.15%;background:#124cfa;will-change:transform;}
  .kuonji-opening__leaf:nth-of-type(2) {left:auto;right:0;}
  .kuonji-opening__leaf:nth-of-type(1) {box-shadow:1px 0 0 rgba(196,216,228,.14),26px 0 60px rgba(0,0,0,.45);}
  .kuonji-opening__leaf:nth-of-type(2) {box-shadow:-1px 0 0 rgba(196,216,228,.14),-26px 0 60px rgba(0,0,0,.45);}
  .kuonji-opening__mark {position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;text-align:center;color:#dbe6ec;}
  .kuonji-opening__kicker,.kuonji-opening__sub {font-size:10px;letter-spacing:.34em;text-indent:.34em;}
  .kuonji-opening__kicker {opacity:0;animation:ko-fade 1s ease .25s forwards;}
  .kuonji-opening__sub {opacity:0;color:#a9f4ff;letter-spacing:.28em;text-indent:.28em;}
  .kuonji-opening__mask {display:block;overflow:hidden;padding:0 .1em;}
  .kuonji-opening__mask strong {display:block;font:800 clamp(34px,9vw,60px)/1.42 "Noto Sans SC","Microsoft YaHei",sans-serif;letter-spacing:.1em;text-indent:.1em;transform:translateY(118%) scaleY(.58);transform-origin:bottom center;will-change:transform;}
  .kuonji-opening__hint {position:absolute;bottom:15%;left:0;right:0;text-align:center;font-size:10px;letter-spacing:.3em;color:#93a7b4;opacity:0;animation:ko-pulse 2.2s ease-in-out .6s infinite;transition:opacity .3s ease;}

  /* 开幕由脚本在场景就绪后触发：html.is-kuonji-open */
  html.is-kuonji-open .kuonji-opening {animation:ko-curtain-hide .01s linear 3.2s forwards;}
  html.is-kuonji-open .kuonji-opening__hint {animation:none;opacity:0;}
  html.is-kuonji-open .kuonji-opening__mask strong {animation:ko-title 1.15s cubic-bezier(.16,1,.3,1) .12s both;}
  html.is-kuonji-open .kuonji-opening__sub {animation:ko-fade 1s ease .95s both;}
  html.is-kuonji-open .kuonji-opening__mark {animation:ko-mark-out .95s cubic-bezier(.76,0,.24,1) 1.3s forwards;}
  html.is-kuonji-open .kuonji-opening__leaf:nth-of-type(1) {animation:ko-leaf-left 1.5s cubic-bezier(.76,0,.24,1) 1.55s forwards;}
  html.is-kuonji-open .kuonji-opening__leaf:nth-of-type(2) {animation:ko-leaf-right 1.5s cubic-bezier(.76,0,.24,1) 1.55s forwards;}
  html.is-kuonji-open #kuonji-scene {animation:ko-scene-in 2.4s cubic-bezier(.16,1,.3,1) 1.5s both;}

  @keyframes ko-fade {from{opacity:0}to{opacity:1}}
  @keyframes ko-title {from{transform:translateY(118%) scaleY(.58)}to{transform:translateY(0) scaleY(1)}}
  @keyframes ko-mark-out {to{clip-path:inset(0 0 100% 0);transform:translateY(-26px)}}
  @keyframes ko-leaf-left {to{transform:translateX(-101%)}}
  @keyframes ko-leaf-right {to{transform:translateX(101%)}}
  @keyframes ko-scene-in {from{transform:scale(1.06)}to{transform:scale(1)}}
  @keyframes ko-curtain-hide {to{visibility:hidden}}
  @keyframes ko-pulse {0%,100%{opacity:.22}50%{opacity:.8}}

  .kuonji-page astro-dev-toolbar {display:none;}

  @media (prefers-reduced-motion: reduce) {
    .kuonji-opening {display:none !important;}
    html.is-kuonji-open #kuonji-scene {animation:none;}
  }
</style>
