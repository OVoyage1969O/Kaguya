---
// A standalone scene intentionally has no blog shell, controls overlay or menu.
---
<!doctype html>
<html lang="zh-CN" class="kuonji-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202a32" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cpath fill='%239caaa7' d='M5 20 20 5l15 15v16H5z'/%3E%3Cpath fill='%23202a32' d='M16 24h8v12h-8z'/%3E%3C/svg%3E" />
    <meta name="description" content="久远寺宅：可旋转与缩放的三渲二微缩庭院。" />
    <title>久远寺宅 · 微缩庭院</title>
  </head>
  <body>
    <main id="kuonji-scene" aria-label="久远寺宅微缩庭院"></main>
    <noscript>请启用 JavaScript 查看三维场景。</noscript>
    <script>
      import { mountKuonji } from '@/components/features/kuonji-diorama/scene';
      let cleanup: (() => void) | undefined;
      const mount=()=>{
        const host=document.getElementById('kuonji-scene');
        if(!host||host.dataset.sceneReady)return;
        try {cleanup=mountKuonji(host);} catch(error) {
          console.error('Unable to initialize Kuonji scene',error);
          host.textContent='三维场景未能加载，请确认浏览器已开启 WebGL / 硬件加速后刷新。';
        }
      };
      mount();
      document.addEventListener('astro:page-load',mount);
      document.addEventListener('astro:before-swap',()=>{cleanup?.();cleanup=undefined;});
      window.addEventListener('pagehide',()=>{cleanup?.();cleanup=undefined;});
      window.addEventListener('pageshow',mount);
    </script>
  </body>
</html>
<style is:global>
  html.kuonji-page,.kuonji-page body {margin:0;width:100%;height:100%;overflow:hidden;background:#202a32;scrollbar-gutter:auto;}
  #kuonji-scene {width:100%;height:100dvh;display:grid;place-items:center;color:#cad4db;font:14px/1.7 serif;}
  #kuonji-scene canvas {display:block;width:100%;height:100%;touch-action:none;cursor:grab;outline:none;}
  #kuonji-scene canvas:active {cursor:grabbing;}
  #kuonji-scene canvas:focus-visible {outline:1px solid #8899a8;outline-offset:-2px;}
  .kuonji-page astro-dev-toolbar {display:none;}
</style>
